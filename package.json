{
  "name": "@eclipse-hopson/sentinel",
  "version": "0.1.7",
  "private": true,
  "description": "Eclipse Hopson Sentinel core runtime for coding, tools, agents, and local operator workflows",
  "type": "module",
  "bin": {
    "sentinel": "./bin/sentinel",
    "sentinel-voice": "./bin/sentinel-voice",
    "sentinel-operator": "./bin/sentinel-operator",
    "sentinel-office-credentials": "./bin/sentinel-office-credentials",
    "pavelcode": "./bin/pavelcode"
  },
  "files": [
    "bin/",
    "dist/cli.mjs",
    "scripts/spec-gate-verify.mjs",
    "dashboard/electron/sentinel-safe-operator.mjs",
    "office/",
    "README.md"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run build && node dist/cli.mjs",
    "dev:profile": "bun run scripts/provider-launch.ts",
    "dev:profile:fast": "bun run scripts/provider-launch.ts auto --fast --bare",
    "dev:codex": "bun run scripts/provider-launch.ts codex",
    "dev:openai": "bun run scripts/provider-launch.ts openai",
    "dev:gemini": "bun run scripts/provider-launch.ts gemini",
    "dev:ollama": "bun run scripts/provider-launch.ts ollama",
    "dev:ollama:fast": "bun run scripts/provider-launch.ts ollama --fast --bare",
    "dev:atomic-chat": "bun run scripts/provider-launch.ts atomic-chat",
    "profile:init": "bun run scripts/provider-bootstrap.ts",
    "profile:recommend": "bun run scripts/provider-recommend.ts",
    "profile:auto": "bun run scripts/provider-recommend.ts --apply",
    "profile:codex": "bun run profile:init -- --provider codex --model codexplan",
    "profile:fast": "bun run profile:init -- --provider ollama --model llama3.2:3b",
    "profile:code": "bun run profile:init -- --provider ollama --model qwen2.5-coder:7b",
    "dev:fast": "bun run profile:fast && bun run dev:ollama:fast",
    "dev:code": "bun run profile:code && bun run dev:profile",
    "start": "node dist/cli.mjs",
    "test:provider-recommendation": "bun test src/utils/providerRecommendation.test.ts src/utils/providerProfile.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:supported": "tsc --noEmit -p tsconfig.supported.json",
    "typecheck:debt": "node scripts/audit-typecheck-debt.mjs",
    "smoke": "bun run build && node dist/cli.mjs --version",
    "rust:build": "cargo build --release --manifest-path rust/Cargo.toml",
    "rust:test": "cargo test --manifest-path rust/Cargo.toml",
    "rust:check": "cargo clippy --manifest-path rust/Cargo.toml --workspace --all-targets -- -D warnings",
    "test:provider": "bun test src/services/api/*.test.ts src/utils/context.test.ts",
    "test:distribution-guard": "bun run build && node scripts/verify-private-distribution.mjs",
    "test:dashboard-security": "node --test scripts/dashboard-security.test.mjs",
    "doctor:runtime": "bun run scripts/system-check.ts",
    "doctor:runtime:json": "bun run scripts/system-check.ts --json",
    "doctor:report": "bun run scripts/system-check.ts --out reports/doctor-runtime.json",
    "doctor:config": "node ./scripts/sentinel-config-health.mjs",
    "doctor:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sentinel-windows-doctor.ps1",
    "doctor:windows:json": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sentinel-windows-doctor.ps1 -Json",
    "doctor:windows:selftest": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sentinel-windows-doctor.ps1 -SelfTest",
    "backup:create": "node ./scripts/sentinel-backup.mjs create",
    "backup:list": "node ./scripts/sentinel-backup.mjs list",
    "backup:restore": "node ./scripts/sentinel-backup.mjs restore",
    "hardening:check": "bun run smoke && bun run doctor:runtime",
    "hardening:strict": "bun run typecheck && bun run hardening:check",
    "spec:verify": "node ./scripts/spec-gate-verify.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "0.3.0",
    "@anthropic-ai/bedrock-sdk": "0.32.1",
    "@anthropic-ai/foundry-sdk": "0.4.1",
    "@anthropic-ai/sandbox-runtime": "0.0.71",
    "@anthropic-ai/sdk": "0.116.0",
    "@anthropic-ai/vertex-sdk": "0.19.1",
    "@commander-js/extra-typings": "12.1.0",
    "@growthbook/growthbook": "1.6.5",
    "@mendable/firecrawl-js": "4.32.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.221.0",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-logs": "0.221.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.40.0",
    "ajv": "8.18.0",
    "auto-bind": "5.0.1",
    "axios": "1.19.0",
    "bidi-js": "1.0.3",
    "chalk": "5.6.2",
    "chokidar": "4.0.3",
    "cli-boxes": "3.0.0",
    "cli-highlight": "2.1.11",
    "code-excerpt": "4.0.0",
    "commander": "12.1.0",
    "diff": "8.0.3",
    "emoji-regex": "10.6.0",
    "env-paths": "3.0.0",
    "execa": "9.6.1",
    "fflate": "0.8.2",
    "figures": "6.1.0",
    "fuse.js": "7.1.0",
    "get-east-asian-width": "1.5.0",
    "google-auth-library": "9.15.1",
    "https-proxy-agent": "7.0.6",
    "ignore": "7.0.5",
    "indent-string": "5.0.0",
    "jsonc-parser": "3.3.1",
    "lodash-es": "4.18.0",
    "lru-cache": "11.2.7",
    "marked": "15.0.12",
    "p-map": "7.0.4",
    "picomatch": "4.0.4",
    "proper-lockfile": "4.1.2",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-compiler-runtime": "1.0.0",
    "react-reconciler": "0.33.0",
    "semver": "7.7.4",
    "shell-quote": "1.10.0",
    "signal-exit": "4.1.0",
    "stack-utils": "2.0.6",
    "strip-ansi": "7.2.0",
    "supports-hyperlinks": "3.2.0",
    "tree-kill": "1.2.2",
    "turndown": "7.2.2",
    "type-fest": "4.41.0",
    "undici": "7.29.0",
    "usehooks-ts": "3.1.1",
    "vscode-languageserver-protocol": "3.17.5",
    "wrap-ansi": "9.0.2",
    "ws": "8.21.0",
    "xss": "1.0.15",
    "yaml": "2.8.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PavelHopson/eclipse-hopson-sentinel"
  },
  "keywords": [
    "eclipse-hopson",
    "sentinel",
    "openai",
    "llm",
    "cli",
    "agent",
    "deepseek",
    "ollama",
    "gemini",
    "voice",
    "local-ai"
  ],
  "license": "SEE LICENSE FILE",
  "overrides": {
    "@grpc/grpc-js": "1.14.4",
    "@hono/node-server": "1.19.17",
    "fast-uri": "3.1.5",
    "fast-xml-builder": "1.3.0",
    "fast-xml-parser": "5.10.1",
    "hono": "4.13.1",
    "ip-address": "10.5.0",
    "protobufjs": "7.6.5",
    "qs": "6.15.3",
    "uuid": "11.1.1",
    "body-parser": "2.3.0"
  }
}
