#!/usr/bin/env node

import { stdin, stdout, stderr } from 'node:process'
import {
  createWindowsOfficeCredentialStore,
  credentialDeleteConfirmation,
  OfficeCredentialError,
} from '../office/windows-office-credential-store.mjs'
import {
  inspectOfficeCredentialRotation,
  stageOfficeCredentialRotation,
} from '../office/office-credential-rotation.mjs'

const USAGE = `Usage:
  sentinel-office-credentials status <producer-id> <key-id>
  sentinel-office-credentials provision <producer-id> <key-id>
  sentinel-office-credentials delete <producer-id> <key-id>
  sentinel-office-credentials rotation-status <producer-id> <current-key-id> <next-key-id>
  sentinel-office-credentials stage-rotation <producer-id> <current-key-id> <next-key-id>`

const ROTATION_STATUS_MESSAGES = Object.freeze({
  'ready-to-stage': 'Current credential is present; the next credential can be staged.',
  staged: 'Both credentials are present. Activate and verify the next key in Office Core before retiring the current key.',
  'next-only': 'Only the next credential is present. Verify Office Core delivery before enabling Sentinel.',
  blocked: 'Neither credential is present. Provision the current key before starting rotation.',
})

function readInput(prompt, { hidden = false } = {}) {
  return new Promise((resolve, reject) => {
    const bytes = []
    const interactive = Boolean(stdin.isTTY && stdin.setRawMode)
    let finished = false
    stdout.write(prompt)
    if (interactive) stdin.setRawMode(true)
    stdin.resume()

    const cleanup = () => {
      stdin.off('data', onData)
      stdin.off('end', onEnd)
      if (interactive) stdin.setRawMode(false)
      stdin.pause()
    }
    const finish = () => {
      if (finished) return
      finished = true
      cleanup()
      stdout.write('\n')
      const value = Buffer.from(bytes)
      bytes.fill(0)
      resolve(value)
    }
    const onEnd = () => finish()
    const onData = (chunk) => {
      const data = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk)
      for (const byte of data) {
        if (byte === 3) {
          finished = true
          cleanup()
          stdout.write('\n')
          reject(new Error('Input cancelled.'))
          return
        }
        if (byte === 13 || byte === 10) {
          finish()
          return
        }
        if (interactive && (byte === 8 || byte === 127)) {
          bytes.pop()
          continue
        }
        if (bytes.length >= 512) {
          finished = true
          cleanup()
          reject(new Error('Input is too long.'))
          return
        }
        bytes.push(byte)
        if (interactive && !hidden) stdout.write(Buffer.from([byte]))
      }
    }
    stdin.on('data', onData)
    stdin.once('end', onEnd)
  })
}

function decodeBase64Url(input) {
  const encoded = input.toString('ascii').trim()
  input.fill(0)
  if (!/^[A-Za-z0-9_-]+$/.test(encoded)) throw new Error('Secret must be unpadded base64url.')
  const secret = Buffer.from(encoded, 'base64url')
  if (secret.byteLength < 32 || secret.byteLength > 128 || secret.toString('base64url') !== encoded) {
    secret.fill(0)
    throw new Error('Secret must decode to 32–128 random bytes.')
  }
  return secret
}

async function main() {
  const [operation, producerId, keyId, ...extra] = process.argv.slice(2)
  const ordinaryOperation = ['status', 'provision', 'delete'].includes(operation) && extra.length === 0
  const rotationOperation = ['rotation-status', 'stage-rotation'].includes(operation) && extra.length === 1
  if ((!ordinaryOperation && !rotationOperation) || !producerId || !keyId) {
    stderr.write(`${USAGE}\n`)
    process.exitCode = 2
    return
  }
  const store = createWindowsOfficeCredentialStore()
  const identity = { producerId, keyId }

  if (rotationOperation) {
    const rotation = {
      credentialStore: store,
      producerId,
      currentKeyId: keyId,
      nextKeyId: extra[0],
    }
    if (operation === 'rotation-status') {
      const result = await inspectOfficeCredentialRotation(rotation)
      stdout.write(`${ROTATION_STATUS_MESSAGES[result.state]}\n`)
      return
    }

    const encoded = await readInput('Next producer secret (base64url, hidden): ', { hidden: true })
    const nextSecret = decodeBase64Url(encoded)
    try {
      await stageOfficeCredentialRotation({ ...rotation, nextSecret })
      stdout.write('Next credential staged; the current credential remains active.\n')
      stdout.write(`Next: activate ${extra[0]} in Office Core, switch SENTINEL_OFFICE_KEY_ID, verify delivery, then retire ${keyId} with the separate delete command.\n`)
    } finally {
      nextSecret.fill(0)
    }
    return
  }


  if (operation === 'status') {
    const result = await store.status(identity)
    stdout.write(result.provisioned
      ? `Credential is provisioned in Windows Credential Manager.\nDelete confirmation: ${result.deleteConfirmation}\n`
      : 'Credential is not provisioned.\n')
    return
  }

  if (operation === 'provision') {
    const encoded = await readInput('Producer secret (base64url, hidden): ', { hidden: true })
    const secret = decodeBase64Url(encoded)
    try {
      await store.provision({ ...identity, secret })
      stdout.write('Credential stored in Windows Credential Manager.\n')
    } finally {
      secret.fill(0)
    }
    return
  }

  const expected = credentialDeleteConfirmation(identity)
  const confirmationBytes = await readInput(`Type exactly "${expected}" to delete: `)
  const confirmation = confirmationBytes.toString('utf8').trim()
  confirmationBytes.fill(0)
  const result = await store.delete({ ...identity, confirmation })
  stdout.write(result.deleted ? 'Credential deleted.\n' : 'Credential was already absent.\n')
}

main().catch((error) => {
  const message = error instanceof OfficeCredentialError || error instanceof Error
    ? error.message
    : 'Credential operation failed.'
  stderr.write(`${message}\n`)
  process.exitCode = 1
})
